<UserControl x:Class="PrettyDesk.App.Views.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PrettyDesk.Presentation.ViewModels;assembly=PrettyDesk.Presentation"
             xmlns:res="clr-namespace:PrettyDesk.Presentation.Resources;assembly=PrettyDesk.Presentation"
             xmlns:views="clr-namespace:PrettyDesk.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LibraryViewModel}"
             Loaded="OnLoaded">
  <UserControl.Resources>
    <DataTemplate DataType="{x:Type vm:GameDetailViewModel}"><views:GameDetailView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AddGameViewModel}"><views:AddGameView /></DataTemplate>
  </UserControl.Resources>

  <Grid>
    <!-- The grid of games -->
    <Grid Visibility="{Binding IsListVisible, Converter={StaticResource BoolToVisibility}}" Margin="24,8,24,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Static res:Strings.Library_Title}" />
        <Button Grid.Column="1" Content="{x:Static res:Strings.Library_AddGame}" Command="{Binding OpenAddGameCommand}" VerticalAlignment="Center"
                AutomationProperties.Name="{x:Static res:Strings.Library_AddGame}" />
      </Grid>

      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,12">
        <ui:TextBox Width="280" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{x:Static res:Strings.Library_Search}"
                 AutomationProperties.Name="{x:Static res:Strings.Library_Search}" />
        <RadioButton GroupName="LibraryFilter" Content="{x:Static res:Strings.Library_FilterAll}" Margin="16,0,0,0"
                     IsChecked="{Binding Filter, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=All}"
                     AutomationProperties.Name="{x:Static res:Strings.Library_FilterAll}" />
        <RadioButton GroupName="LibraryFilter" Content="{x:Static res:Strings.Library_FilterInstalled}" Margin="8,0,0,0"
                     IsChecked="{Binding Filter, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=Installed}"
                     AutomationProperties.Name="{x:Static res:Strings.Library_FilterInstalled}" />
        <RadioButton GroupName="LibraryFilter" Content="{x:Static res:Strings.Library_FilterEnabled}" Margin="8,0,0,0"
                     IsChecked="{Binding Filter, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=Enabled}"
                     AutomationProperties.Name="{x:Static res:Strings.Library_FilterEnabled}" />
      </StackPanel>

      <TextBlock Grid.Row="2" Style="{StaticResource MutedStyle}" Margin="0,0,0,8" Text="{Binding Toast}" Visibility="{Binding Toast, Converter={StaticResource NullToCollapsed}}" />
      <TextBlock Grid.Row="2" Style="{StaticResource ErrorTextStyle}" Margin="0,0,0,8" Text="{Binding ErrorMessage}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

      <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,0,24">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Games}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:GameCardViewModel}">
                <Border Width="224" Margin="0,0,16,16" Style="{StaticResource CardStyle}" Padding="0">
                  <StackPanel>
                    <Button Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                            Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Name}">
                      <StackPanel>
                        <Grid Height="126">
                          <Border Style="{StaticResource PlaceholderTileStyle}" CornerRadius="8,8,0,0">
                            <TextBlock Text="{Binding Initial}" FontSize="44" FontWeight="SemiBold" Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <Border CornerRadius="8,8,0,0" Visibility="{Binding ThumbnailPath, Converter={StaticResource NullToCollapsed}}">
                            <Border.Background>
                              <ImageBrush ImageSource="{Binding ThumbnailPath, Converter={StaticResource PathToImage}, ConverterParameter=448}" Stretch="UniformToFill" />
                            </Border.Background>
                          </Border>
                        </Grid>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Style="{StaticResource BodyStyle}" TextTrimming="CharacterEllipsis" Margin="12,10,12,4" />
                      </StackPanel>
                    </Button>
                    <Grid Margin="12,0,12,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Style="{StaticResource ChipStyle}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Style="{StaticResource BodyStyle}" />
                      </Border>
                      <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}" AutomationProperties.Name="{Binding ToggleLabel}" />
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Designed empty state -->
          <StackPanel Visibility="{Binding HasGames, Converter={StaticResource InverseBoolToVisibility}}" HorizontalAlignment="Center" Margin="0,48,0,0" MaxWidth="420">
            <TextBlock Style="{StaticResource BodyStyle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Text="{Binding EmptyTitle}" />
            <TextBlock Style="{StaticResource MutedStyle}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,16" Text="{Binding EmptyBody}" />
            <Button Content="{x:Static res:Strings.Library_AddGame}" Command="{Binding OpenAddGameCommand}" HorizontalAlignment="Center" AutomationProperties.Name="{x:Static res:Strings.Library_AddGame}" />
          </StackPanel>

          <TextBlock Style="{StaticResource MutedStyle}" FontSize="12" Margin="0,8,0,0" Text="{x:Static res:Strings.Library_DisclaimerNote}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <ContentControl Content="{Binding Detail}" Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}" Focusable="False" />
    <ContentControl Content="{Binding AddGame}" Visibility="{Binding AddGame, Converter={StaticResource NullToCollapsed}}" Focusable="False" />
  </Grid>
</UserControl>
