<UserControl x:Class="PrettyDesk.App.Views.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PrettyDesk.Presentation.ViewModels;assembly=PrettyDesk.Presentation"
             xmlns:res="clr-namespace:PrettyDesk.Presentation.Resources;assembly=PrettyDesk.Presentation"
             xmlns:views="clr-namespace:PrettyDesk.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LibraryViewModel}"
             Loaded="OnLoaded">
  <UserControl.Resources>
    <DataTemplate DataType="{x:Type vm:GameDetailViewModel}"><views:GameDetailView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AddGameViewModel}"><views:AddGameView /></DataTemplate>
  </UserControl.Resources>

  <Grid>
    <!-- The grid of games -->
    <Grid Visibility="{Binding IsListVisible, Converter={StaticResource BoolToVisibility}}" Margin="32,24,32,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Static res:Strings.Library_Title}" />
        <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Content="{x:Static res:Strings.Library_AddGame}" Command="{Binding OpenAddGameCommand}" VerticalAlignment="Center"
                AutomationProperties.Name="{x:Static res:Strings.Library_AddGame}" />
      </Grid>

      <WrapPanel Grid.Row="1" Margin="0,16,0,16">
        <ui:TextBox Width="280" Margin="0,0,16,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{x:Static res:Strings.Library_Search}"
                 AutomationProperties.Name="{x:Static res:Strings.Library_Search}" />
        <Border Style="{StaticResource SegmentedBarStyle}">
          <StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource SegmentedOptionStyle}" GroupName="LibraryFilter" Content="{x:Static res:Strings.Library_FilterAll}"
                         IsChecked="{Binding Filter, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=All}"
                         AutomationProperties.Name="{x:Static res:Strings.Library_FilterAll}" />
            <RadioButton Style="{StaticResource SegmentedOptionStyle}" GroupName="LibraryFilter" Content="{x:Static res:Strings.Library_FilterInstalled}"
                         IsChecked="{Binding Filter, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=Installed}"
                         AutomationProperties.Name="{x:Static res:Strings.Library_FilterInstalled}" />
            <RadioButton Style="{StaticResource SegmentedOptionStyle}" GroupName="LibraryFilter" Content="{x:Static res:Strings.Library_FilterEnabled}"
                         IsChecked="{Binding Filter, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=Enabled}"
                         AutomationProperties.Name="{x:Static res:Strings.Library_FilterEnabled}" />
          </StackPanel>
        </Border>
      </WrapPanel>

      <TextBlock Grid.Row="2" Style="{StaticResource MutedStyle}" Margin="0,0,0,8" Text="{Binding Toast}" Visibility="{Binding Toast, Converter={StaticResource NullToCollapsed}}" />
      <TextBlock Grid.Row="2" Style="{StaticResource ErrorTextStyle}" Margin="0,0,0,8" Text="{Binding ErrorMessage}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

      <Grid Grid.Row="3" Margin="0,0,0,16">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <ui:VirtualizingGridView x:Name="GameTiles" ItemsSource="{Binding Games}" Focusable="False"
                                  Orientation="Vertical" SpacingMode="None" StretchItems="False"
                                  Background="Transparent" BorderThickness="0" Padding="0"
                                  VirtualizingPanel.CacheLength="0.5" VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  AutomationProperties.Name="{x:Static res:Strings.Library_Title}">
            <ui:VirtualizingGridView.ItemContainerStyle>
              <Style TargetType="ListViewItem" d:DataType="{x:Type vm:GameCardViewModel}">
                <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
              </Style>
            </ui:VirtualizingGridView.ItemContainerStyle>
            <ui:VirtualizingGridView.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:GameCardViewModel}">
                <Border Width="236" Margin="0,0,16,16" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                  <StackPanel>
                    <Button Style="{StaticResource FlatButtonStyle}"
                            Command="{Binding DataContext.OpenGameCommand, Source={x:Reference GameTiles}}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Name}">
                      <StackPanel>
                        <Grid Height="172">
                          <Border Style="{StaticResource PlaceholderTileStyle}" CornerRadius="9,9,0,0">
                            <TextBlock Text="{Binding Initial}" FontSize="44" FontWeight="SemiBold" Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <Border CornerRadius="9,9,0,0" Visibility="{Binding ThumbnailPath, Converter={StaticResource NullToCollapsed}}">
                            <Border.Background>
                              <ImageBrush ImageSource="{Binding ThumbnailPath, Converter={StaticResource PathToImage}, ConverterParameter=448}" Stretch="UniformToFill" />
                            </Border.Background>
                          </Border>
                        </Grid>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Style="{StaticResource BodyStyle}" TextTrimming="CharacterEllipsis" Margin="12,10,12,4" />
                      </StackPanel>
                    </Button>
                    <Grid Margin="12,0,12,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Style="{StaticResource ChipStyle}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Style="{StaticResource BodyStyle}" />
                      </Border>
                      <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}" AutomationProperties.Name="{Binding ToggleLabel}" />
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ui:VirtualizingGridView.ItemTemplate>
          </ui:VirtualizingGridView>

          <!-- Designed empty state -->
          <StackPanel Visibility="{Binding HasGames, Converter={StaticResource InverseBoolToVisibility}}" HorizontalAlignment="Center" Margin="0,48,0,0" MaxWidth="420">
            <TextBlock Style="{StaticResource BodyStyle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Text="{Binding EmptyTitle}" />
            <TextBlock Style="{StaticResource MutedStyle}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,16" Text="{Binding EmptyBody}" />
            <Button Style="{StaticResource PrimaryButtonStyle}" Content="{x:Static res:Strings.Library_AddGame}" Command="{Binding OpenAddGameCommand}" HorizontalAlignment="Center" AutomationProperties.Name="{x:Static res:Strings.Library_AddGame}" />
          </StackPanel>

          <TextBlock Grid.Row="1" Style="{StaticResource MutedStyle}" FontSize="12" Margin="0,8,0,0" Text="{x:Static res:Strings.Library_DisclaimerNote}" />
      </Grid>
    </Grid>

    <ContentControl Content="{Binding Detail}" Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}" Focusable="False" />
    <ContentControl Content="{Binding AddGame}" Visibility="{Binding AddGame, Converter={StaticResource NullToCollapsed}}" Focusable="False" />
  </Grid>
</UserControl>
