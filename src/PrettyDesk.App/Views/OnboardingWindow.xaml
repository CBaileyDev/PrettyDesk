<ui:FluentWindow x:Class="PrettyDesk.App.Views.OnboardingWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:vm="clr-namespace:PrettyDesk.Presentation.ViewModels;assembly=PrettyDesk.Presentation"
                 xmlns:res="clr-namespace:PrettyDesk.Presentation.Resources;assembly=PrettyDesk.Presentation"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:OnboardingViewModel}"
                 Title="PrettyDesk" Width="760" Height="600" MinWidth="640" MinHeight="520"
                 WindowStartupLocation="CenterScreen"
                 Background="{DynamicResource DeskAmbientBrush}" FontFamily="Segoe UI Variable, Segoe UI" WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 AutomationProperties.Name="PrettyDesk">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="PrettyDesk" ShowMaximize="False" />

    <Grid Grid.Row="1" Margin="40,8,40,16">
      <!-- Welcome -->
      <StackPanel VerticalAlignment="Center" Visibility="{Binding Step, Converter={StaticResource EnumEqualsToVisibility}, ConverterParameter=Welcome}">
        <TextBlock Style="{StaticResource PageTitleStyle}" FontSize="34" Text="{x:Static res:Strings.Onboard_WelcomeTitle}" />
        <TextBlock Style="{StaticResource BodyStyle}" FontSize="16" Margin="0,8,0,24" Text="{x:Static res:Strings.Onboard_WelcomeBody}" />
        <TextBlock Style="{StaticResource MutedStyle}" FontSize="14" Margin="0,0,0,6" Text="{x:Static res:Strings.Onboard_WelcomePoint1}" />
        <TextBlock Style="{StaticResource MutedStyle}" FontSize="14" Margin="0,0,0,6" Text="{x:Static res:Strings.Onboard_WelcomePoint2}" />
        <TextBlock Style="{StaticResource MutedStyle}" FontSize="14" Text="{x:Static res:Strings.Onboard_WelcomePoint3}" />
      </StackPanel>

      <!-- Setup style -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Step, Converter={StaticResource EnumEqualsToVisibility}, ConverterParameter=Style}">
        <StackPanel>
          <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Static res:Strings.Onboard_StyleTitle}" />
          <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Static res:Strings.Onboard_StyleBody}" Margin="0,0,0,16" />
          <ItemsControl ItemsSource="{Binding StyleOptions}" Focusable="False" AutomationProperties.Name="{x:Static res:Strings.Onboard_StyleTitle}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:StyleOption}">
                <RadioButton GroupName="SetupStyle" Width="200" Margin="0,0,12,12" Padding="12" HorizontalContentAlignment="Stretch"
                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                             Command="{Binding DataContext.ChooseStyleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                             AutomationProperties.Name="{Binding Title}">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Style="{StaticResource BodyStyle}" />
                    <TextBlock Text="{Binding Help}" Style="{StaticResource MutedStyle}" FontSize="12" />
                  </StackPanel>
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Visibility="{Binding ShowSpotlightNote, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Static res:Strings.Onboard_SpotlightNote}" />
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Mode -->
      <StackPanel Visibility="{Binding Step, Converter={StaticResource EnumEqualsToVisibility}, ConverterParameter=Mode}">
        <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Static res:Strings.Onboard_ModeTitle}" />
        <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Static res:Strings.Onboard_ModeBody}" Margin="0,0,0,16" />
        <RadioButton GroupName="OnboardMode" Content="{x:Static res:Strings.Onboard_ModeRotate}" IsChecked="{Binding IsRotate, Mode=TwoWay}" AutomationProperties.Name="{x:Static res:Strings.Onboard_ModeRotate}" />
        <RadioButton GroupName="OnboardMode" Margin="0,8,0,0" Content="{x:Static res:Strings.Onboard_ModeFixed}" IsChecked="{Binding IsRotate, Mode=TwoWay, Converter={StaticResource InverseBool}}"
                     AutomationProperties.Name="{x:Static res:Strings.Onboard_ModeFixed}" />
        <StackPanel Margin="0,20,0,0" Visibility="{Binding IsRotate, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Style="{StaticResource BodyStyle}" Text="{x:Static res:Strings.Onboard_ModeInterval}" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding IntervalChoices}" SelectedItem="{Binding SelectedInterval, Mode=TwoWay}" DisplayMemberPath="Label" MinWidth="220" HorizontalAlignment="Left"
                    AutomationProperties.Name="{x:Static res:Strings.Onboard_ModeInterval}" />
        </StackPanel>
      </StackPanel>

      <!-- Games found -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Step, Converter={StaticResource EnumEqualsToVisibility}, ConverterParameter=Games}">
        <StackPanel>
          <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Static res:Strings.Onboard_GamesTitle}" />
          <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Static res:Strings.Onboard_GamesBody}" Margin="0,0,0,16" />
          <StackPanel Visibility="{Binding IsLoadingGames, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Static res:Strings.Onboard_GamesLoading}" />
            <ProgressBar IsIndeterminate="True" Margin="0,8,0,0" AutomationProperties.Name="{x:Static res:Strings.Onboard_GamesLoading}" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Games}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:OnboardingGameViewModel}">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="12">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStyle}" VerticalAlignment="Center" />
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Visibility="{Binding ShowGamesEmpty, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
            <TextBlock Style="{StaticResource BodyStyle}" FontWeight="SemiBold" Text="{x:Static res:Strings.Onboard_GamesEmptyTitle}" />
            <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Static res:Strings.Onboard_GamesEmptyBody}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Wallpapers matched to the user's displays -->
      <Grid Visibility="{Binding Step, Converter={StaticResource EnumEqualsToVisibility}, ConverterParameter=Wallpapers}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Static res:Strings.Onboard_WallpapersTitle}" />
          <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Static res:Strings.Onboard_WallpapersBody}" Margin="0,0,0,12" />
          <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Style="{StaticResource BodyStyle}" FontWeight="SemiBold" Text="{Binding DisplaySummary}" AutomationProperties.LiveSetting="Polite" />
              <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Static res:Strings.Onboard_DisplayFitHelp}" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
        <ScrollViewer x:Name="WallpaperList" Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding WallpaperChoices}" Focusable="False" AutomationProperties.Name="{x:Static res:Strings.Onboard_WallpapersTitle}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:OnboardingPackViewModel}">
                  <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" AutomationProperties.Name="{Binding Name}">
                        <TextBlock Style="{StaticResource BodyStyle}" FontWeight="SemiBold" Text="{Binding Name}" />
                      </CheckBox>
                      <TextBlock Style="{StaticResource MutedStyle}" Text="{Binding Status}" Margin="26,4,0,0" AutomationProperties.LiveSetting="Polite" />
                      <ProgressBar Maximum="100" Value="{Binding Progress}" Margin="26,8,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding Name}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Static res:Strings.Onboard_NoGamePacks}" Visibility="{Binding HasWallpaperChoices, Converter={StaticResource InverseBoolToVisibility}}" />
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,8,0,0" Visibility="{Binding HasWallpaperChoices, Converter={StaticResource BoolToVisibility}}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource BodyStyle}" Text="{Binding DownloadSummary}" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite" />
            <ui:Button Grid.Column="1" Content="{x:Static res:Strings.Onboard_DownloadSelected}" Command="{Binding DownloadSelectedCommand}" AutomationProperties.Name="{x:Static res:Strings.Onboard_DownloadSelected}" />
          </Grid>
          <CheckBox IsChecked="{Binding DownloadInBackground, Mode=TwoWay}" Content="{x:Static res:Strings.Onboard_DownloadBackground}" Margin="0,12,0,0" AutomationProperties.Name="{x:Static res:Strings.Onboard_DownloadBackground}" />
          <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Static res:Strings.Onboard_BackgroundHelp}" Margin="0,4,0,0" />
        </StackPanel>
      </Grid>

      <!-- Start with Windows -->
      <StackPanel Visibility="{Binding Step, Converter={StaticResource EnumEqualsToVisibility}, ConverterParameter=Startup}">
        <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Static res:Strings.Onboard_StartupTitle}" />
        <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Static res:Strings.Onboard_StartupBody}" Margin="0,0,0,16" />
        <ui:ToggleSwitch IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Content="{x:Static res:Strings.Onboard_StartupToggle}" AutomationProperties.Name="{x:Static res:Strings.Onboard_StartupToggle}" />
        <TextBlock Style="{StaticResource ErrorTextStyle}" Margin="0,16,0,0" Text="{Binding ErrorMessage}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>

      <!-- Done -->
      <StackPanel VerticalAlignment="Center" Visibility="{Binding Step, Converter={StaticResource EnumEqualsToVisibility}, ConverterParameter=Done}">
        <TextBlock Style="{StaticResource PageTitleStyle}" FontSize="34" Text="{x:Static res:Strings.Onboard_DoneTitle}" />
        <TextBlock Style="{StaticResource BodyStyle}" FontSize="16" Margin="0,8,0,16" Text="{x:Static res:Strings.Onboard_DoneBody}" />
        <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Static res:Strings.Onboard_DoneTip}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" Margin="40,0,40,24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Style="{StaticResource MutedStyle}" VerticalAlignment="Center" Text="{Binding StepText}" />
      <ui:Button Grid.Column="1" Margin="0,0,8,0" MinWidth="96" Content="{x:Static res:Strings.Common_Back}" Command="{Binding BackCommand}" AutomationProperties.Name="{x:Static res:Strings.Common_Back}" />
      <ui:Button Grid.Column="2" Appearance="Primary" MinWidth="120" Content="{Binding NextText}" Command="{Binding NextCommand}" IsDefault="True" AutomationProperties.Name="{Binding NextText}" />
    </Grid>
  </Grid>
</ui:FluentWindow>
