<UserControl x:Class="PrettyDesk.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PrettyDesk.Presentation.ViewModels;assembly=PrettyDesk.Presentation"
             xmlns:res="clr-namespace:PrettyDesk.Presentation.Resources;assembly=PrettyDesk.Presentation"
             xmlns:views="clr-namespace:PrettyDesk.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,32">
    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Static res:Strings.Settings_Title}" />

      <!-- General -->
      <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Static res:Strings.Settings_General}" />
      <Border Style="{StaticResource CardStyle}" Padding="20,4">
        <StackPanel>
          <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="{x:Static res:Strings.Settings_AppTheme}" views:SettingRow.Description="{x:Static res:Strings.Settings_AppThemeHelp}">
            <ComboBox ItemsSource="{x:Static vm:GeneralSettingsViewModel.ThemeChoices}" SelectedItem="{Binding General.Theme, Mode=TwoWay}" MinWidth="160" AutomationProperties.Name="{x:Static res:Strings.Settings_AppTheme}" />
          </HeaderedContentControl>
          <Border Style="{StaticResource DividerStyle}" />
          <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="{x:Static res:Strings.Settings_StartWithWindows}" views:SettingRow.Description="{x:Static res:Strings.Settings_StartWithWindowsHelp}">
            <ui:ToggleSwitch IsChecked="{Binding General.StartWithWindows, Mode=TwoWay}" AutomationProperties.Name="{x:Static res:Strings.Settings_StartWithWindows}" />
          </HeaderedContentControl>
          <Border Style="{StaticResource DividerStyle}" />
          <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="{x:Static res:Strings.Settings_RestoreOnExit}" views:SettingRow.Description="{x:Static res:Strings.Settings_RestoreOnExitHelp}">
            <ui:ToggleSwitch IsChecked="{Binding General.RestoreOnExit, Mode=TwoWay}" AutomationProperties.Name="{x:Static res:Strings.Settings_RestoreOnExit}" />
          </HeaderedContentControl>
          <Border Style="{StaticResource DividerStyle}" />
          <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="{x:Static res:Strings.Settings_BetaUpdates}" views:SettingRow.Description="{x:Static res:Strings.Settings_BetaUpdatesHelp}">
            <ui:ToggleSwitch IsChecked="{Binding General.BetaUpdates, Mode=TwoWay}" AutomationProperties.Name="{x:Static res:Strings.Settings_BetaUpdates}" />
          </HeaderedContentControl>
          <Border Style="{StaticResource DividerStyle}" />
          <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="{x:Static res:Strings.Settings_DesktopClock}" views:SettingRow.Description="{x:Static res:Strings.Settings_DesktopClockHelp}">
            <ui:ToggleSwitch IsChecked="{Binding General.DesktopClock, Mode=TwoWay}" AutomationProperties.Name="{x:Static res:Strings.Settings_DesktopClock}" />
          </HeaderedContentControl>
          <Border Style="{StaticResource DividerStyle}" />
          <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="{x:Static res:Strings.Settings_ClockMonitor}">
            <ComboBox ItemsSource="{Binding General.ClockMonitors}" SelectedItem="{Binding General.ClockMonitor, Mode=TwoWay}" DisplayMemberPath="Label" MinWidth="160" AutomationProperties.Name="{x:Static res:Strings.Settings_ClockMonitor}" />
          </HeaderedContentControl>
          <Border Style="{StaticResource DividerStyle}" />
          <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="{x:Static res:Strings.Settings_NowPlaying}">
            <ui:ToggleSwitch IsChecked="{Binding General.DesktopNowPlaying, Mode=TwoWay}" AutomationProperties.Name="{x:Static res:Strings.Settings_NowPlaying}" />
          </HeaderedContentControl>
          <Border Style="{StaticResource DividerStyle}" />
          <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="{x:Static res:Strings.Settings_Visualizer}" views:SettingRow.Description="{x:Static res:Strings.Settings_VisualizerHelp}">
            <ui:ToggleSwitch IsChecked="{Binding General.DesktopVisualizer, Mode=TwoWay}" AutomationProperties.Name="{x:Static res:Strings.Settings_Visualizer}" />
          </HeaderedContentControl>
          <Border Style="{StaticResource DividerStyle}" />
          <WrapPanel Margin="0,12">
            <Button Content="{x:Static res:Strings.Settings_PlayPause}" Command="{Binding General.PlayPauseCommand}" Margin="0,0,8,0" AutomationProperties.Name="{x:Static res:Strings.Settings_PlayPause}" />
            <Button Content="{x:Static res:Strings.Settings_NextTrack}" Command="{Binding General.NextTrackCommand}" AutomationProperties.Name="{x:Static res:Strings.Settings_NextTrack}" />
          </WrapPanel>
          <Border Style="{StaticResource DividerStyle}" />
          <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="{x:Static res:Strings.Settings_WindowsColors}" views:SettingRow.Description="{x:Static res:Strings.Settings_WindowsColorsHelp}">
            <Button Content="{x:Static res:Strings.Settings_OpenColors}" Click="OnOpenColors" AutomationProperties.Name="{x:Static res:Strings.Settings_OpenColors}" />
          </HeaderedContentControl>
          <TextBlock Style="{StaticResource ErrorTextStyle}" Margin="0,0,0,12" Text="{Binding General.ErrorMessage}" Visibility="{Binding General.HasError, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Border>

      <!-- Detection -->
      <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Static res:Strings.Settings_Detection}" />
      <Border Style="{StaticResource CardStyle}" Padding="20,4">
        <StackPanel>
          <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="{x:Static res:Strings.Settings_DetectGames}" views:SettingRow.Description="{x:Static res:Strings.Settings_DetectGamesHelp}">
            <ui:ToggleSwitch IsChecked="{Binding Detection.Enabled, Mode=TwoWay}" AutomationProperties.Name="{x:Static res:Strings.Settings_DetectGames}" />
          </HeaderedContentControl>
          <Border Style="{StaticResource DividerStyle}" />
          <StackPanel Margin="0,12">
            <TextBlock Style="{StaticResource BodyStyle}"><Run Text="{x:Static res:Strings.Settings_PollSeconds}" FontWeight="SemiBold" /> <Run Text="{Binding Detection.PollSecondsText, Mode=OneWay}" Foreground="{DynamicResource DeskAccentTextBrush}" FontWeight="SemiBold" /></TextBlock>
            <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Detection.PollSeconds, Mode=TwoWay}" AutomationProperties.Name="{x:Static res:Strings.Settings_PollSeconds}" />
          </StackPanel>
          <Border Style="{StaticResource DividerStyle}" />
          <StackPanel Margin="0,12">
            <TextBlock Style="{StaticResource BodyStyle}"><Run Text="{x:Static res:Strings.Settings_DetectDelay}" FontWeight="SemiBold" /> <Run Text="{Binding Detection.DetectDelayText, Mode=OneWay}" Foreground="{DynamicResource DeskAccentTextBrush}" FontWeight="SemiBold" /></TextBlock>
            <Slider Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Detection.DetectDelaySeconds, Mode=TwoWay}" AutomationProperties.Name="{x:Static res:Strings.Settings_DetectDelay}" />
            <TextBlock Style="{StaticResource MutedStyle}" FontSize="13" Text="{x:Static res:Strings.Settings_DetectDelayHelp}" />
          </StackPanel>
          <Border Style="{StaticResource DividerStyle}" />
          <StackPanel Margin="0,12">
            <TextBlock Style="{StaticResource BodyStyle}"><Run Text="{x:Static res:Strings.Settings_ExitGrace}" FontWeight="SemiBold" /> <Run Text="{Binding Detection.ExitGraceText, Mode=OneWay}" Foreground="{DynamicResource DeskAccentTextBrush}" FontWeight="SemiBold" /></TextBlock>
            <Slider Minimum="0" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Detection.ExitGraceSeconds, Mode=TwoWay}" AutomationProperties.Name="{x:Static res:Strings.Settings_ExitGrace}" />
            <TextBlock Style="{StaticResource MutedStyle}" FontSize="13" Text="{x:Static res:Strings.Settings_ExitGraceHelp}" />
          </StackPanel>
          <Border Style="{StaticResource DividerStyle}" />
          <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="{x:Static res:Strings.Settings_UnknownGameHints}" views:SettingRow.Description="{x:Static res:Strings.Settings_UnknownGameHintsHelp}">
            <ui:ToggleSwitch IsChecked="{Binding Detection.UnknownGameHints, Mode=TwoWay}" AutomationProperties.Name="{x:Static res:Strings.Settings_UnknownGameHints}" />
          </HeaderedContentControl>
        </StackPanel>
      </Border>

      <!-- Monitors -->
      <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Static res:Strings.Settings_Monitors}" />
      <Border Style="{StaticResource CardStyle}" Padding="20,4">
        <StackPanel>
          <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="{x:Static res:Strings.Settings_MonitorMode}">
            <Border Style="{StaticResource SegmentedBarStyle}">
              <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource SegmentedOptionStyle}" GroupName="MonitorMode" Content="{x:Static res:Strings.Settings_MonitorSame}" IsChecked="{Binding Monitors.DifferentPerMonitor, Mode=TwoWay, Converter={StaticResource InverseBool}}"
                             AutomationProperties.Name="{x:Static res:Strings.Settings_MonitorSame}" />
                <RadioButton Style="{StaticResource SegmentedOptionStyle}" GroupName="MonitorMode" Content="{x:Static res:Strings.Settings_MonitorDifferent}" IsChecked="{Binding Monitors.DifferentPerMonitor, Mode=TwoWay}"
                             AutomationProperties.Name="{x:Static res:Strings.Settings_MonitorDifferent}" />
              </StackPanel>
            </Border>
          </HeaderedContentControl>
          <Border Style="{StaticResource DividerStyle}" />
          <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="{x:Static res:Strings.Settings_GameOnSecondaryOnly}" views:SettingRow.Description="{x:Static res:Strings.Settings_GameOnSecondaryOnlyHelp}">
            <ui:ToggleSwitch IsChecked="{Binding Monitors.GameOnSecondaryOnly, Mode=TwoWay}" AutomationProperties.Name="{x:Static res:Strings.Settings_GameOnSecondaryOnly}" />
          </HeaderedContentControl>
        </StackPanel>
      </Border>

      <!-- Storage -->
      <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Static res:Strings.Settings_Storage}" />
      <Border Style="{StaticResource CardStyle}" Padding="20,4">
        <StackPanel>
          <StackPanel Margin="0,14,0,0">
            <TextBlock Style="{StaticResource BodyStyle}" FontWeight="SemiBold" Text="{Binding Storage.UsageText}" />
          </StackPanel>
          <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="{x:Static res:Strings.Settings_StorageCap}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource MutedStyle}" VerticalAlignment="Center" Margin="0,0,12,0" Text="{Binding Storage.CapText}" />
              <ComboBox ItemsSource="{x:Static vm:StorageSettingsViewModel.CapChoicesGb}" SelectedItem="{Binding Storage.MaxCacheGb, Mode=TwoWay}" MinWidth="100" AutomationProperties.Name="{x:Static res:Strings.Settings_StorageCap}" />
            </StackPanel>
          </HeaderedContentControl>
          <Border Style="{StaticResource DividerStyle}" />
          <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="{x:Static res:Strings.Settings_PrefetchGames}" views:SettingRow.Description="{x:Static res:Strings.Settings_PrefetchGamesHelp}">
            <ui:ToggleSwitch IsChecked="{Binding Storage.PrefetchInstalledGames, Mode=TwoWay}" AutomationProperties.Name="{x:Static res:Strings.Settings_PrefetchGames}" />
          </HeaderedContentControl>
          <Border Style="{StaticResource DividerStyle}" />
          <StackPanel Margin="0,12,0,14">
            <Button Content="{x:Static res:Strings.Settings_ClearDownloads}" Command="{Binding Storage.ClearCommand}" HorizontalAlignment="Left" AutomationProperties.Name="{x:Static res:Strings.Settings_ClearDownloads}" />
            <ProgressBar IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding Storage.IsBusy, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{x:Static res:Strings.Settings_Working}" />
            <TextBlock Style="{StaticResource MutedStyle}" Margin="0,8,0,0" Text="{Binding Storage.ResultMessage}" Visibility="{Binding Storage.ResultMessage, Converter={StaticResource NullToCollapsed}}" />
            <TextBlock Style="{StaticResource ErrorTextStyle}" Margin="0,8,0,0" Text="{Binding Storage.ErrorMessage}" Visibility="{Binding Storage.HasError, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Notifications -->
      <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Static res:Strings.Settings_Notifications}" />
      <Border Style="{StaticResource CardStyle}" Padding="20,4">
        <StackPanel>
          <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="{x:Static res:Strings.Settings_NotifyDownloadErrors}">
            <ui:ToggleSwitch IsChecked="{Binding Notifications.DownloadErrors, Mode=TwoWay}" AutomationProperties.Name="{x:Static res:Strings.Settings_NotifyDownloadErrors}" />
          </HeaderedContentControl>
          <Border Style="{StaticResource DividerStyle}" />
          <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="{x:Static res:Strings.Settings_NotifyUpdates}">
            <ui:ToggleSwitch IsChecked="{Binding Notifications.Updates, Mode=TwoWay}" AutomationProperties.Name="{x:Static res:Strings.Settings_NotifyUpdates}" />
          </HeaderedContentControl>
          <Border Style="{StaticResource DividerStyle}" />
          <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="{x:Static res:Strings.Settings_NotifyUnknownGames}">
            <ui:ToggleSwitch IsChecked="{Binding Notifications.UnknownGames, Mode=TwoWay}" AutomationProperties.Name="{x:Static res:Strings.Settings_NotifyUnknownGames}" />
          </HeaderedContentControl>
          <Border Style="{StaticResource DividerStyle}" />
          <TextBlock Style="{StaticResource MutedStyle}" FontSize="13" Margin="0,0,0,14" Text="{x:Static res:Strings.Settings_NotifyHelp}" />
        </StackPanel>
      </Border>

      <!-- Advanced -->
      <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Static res:Strings.Settings_Advanced}" />
      <Border Style="{StaticResource CardStyle}" Padding="20,16">
        <StackPanel>
          <TextBlock Style="{StaticResource BodyStyle}" FontWeight="SemiBold" Text="{x:Static res:Strings.Settings_DetectionLog}" />
          <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Static res:Strings.Settings_DetectionLogHelp}" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
            <ToggleButton Content="{x:Static res:Strings.Settings_DetectionLogPause}" IsChecked="{Binding Advanced.LogPaused, Mode=TwoWay}" AutomationProperties.Name="{x:Static res:Strings.Settings_DetectionLogPause}" />
            <Button Margin="8,0,0,0" Content="{x:Static res:Strings.Settings_DetectionLogClear}" Command="{Binding Advanced.ClearLogCommand}" AutomationProperties.Name="{x:Static res:Strings.Settings_DetectionLogClear}" />
          </StackPanel>
          <Border Background="{DynamicResource DeskSoftBrush}" CornerRadius="6" Padding="8" MinHeight="96">
            <Grid>
              <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Static res:Strings.Settings_DetectionLogEmpty}" Visibility="{Binding Advanced.HasLog, Converter={StaticResource InverseBoolToVisibility}}" />
              <ListBox ItemsSource="{Binding Advanced.Log}" MaxHeight="180" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{x:Static res:Strings.Settings_DetectionLog}"
                       Visibility="{Binding Advanced.HasLog, Converter={StaticResource BoolToVisibility}}">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:DetectionLogEntry}">
                    <TextBlock Text="{Binding Text}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Style="{StaticResource BodyStyle}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="{x:Static res:Strings.Settings_OpenLogs}" Command="{Binding Advanced.OpenLogsCommand}" AutomationProperties.Name="{x:Static res:Strings.Settings_OpenLogs}" />
            <Button Margin="8,0,0,0" Content="{x:Static res:Strings.Settings_ExportDiagnostics}" Command="{Binding Advanced.ExportCommand}" AutomationProperties.Name="{x:Static res:Strings.Settings_ExportDiagnostics}" />
            <Button Margin="8,0,0,0" Content="{x:Static res:Strings.Settings_ShowInFolder}" Command="{Binding Advanced.ShowExportCommand}" Visibility="{Binding Advanced.ExportedPath, Converter={StaticResource NullToCollapsed}}"
                    AutomationProperties.Name="{x:Static res:Strings.Settings_ShowInFolder}" />
          </StackPanel>
          <TextBlock Style="{StaticResource MutedStyle}" Margin="0,4,0,0" Text="{x:Static res:Strings.Settings_ExportDiagnosticsHelp}" />
          <ProgressBar IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding Advanced.IsBusy, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{x:Static res:Strings.Settings_Working}" />
          <TextBlock Style="{StaticResource MutedStyle}" Margin="0,8,0,0" Text="{Binding Advanced.ResultMessage}" Visibility="{Binding Advanced.ResultMessage, Converter={StaticResource NullToCollapsed}}" />
          <TextBlock Style="{StaticResource ErrorTextStyle}" Margin="0,8,0,0" Text="{Binding Advanced.ErrorMessage}" Visibility="{Binding Advanced.HasError, Converter={StaticResource BoolToVisibility}}" />

          <TextBlock Style="{StaticResource BodyStyle}" FontWeight="SemiBold" Margin="0,24,0,0" Text="{x:Static res:Strings.Settings_ResetApp}" />
          <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Static res:Strings.Settings_ResetAppHelp}" />
          <Button Margin="0,8,0,0" Content="{x:Static res:Strings.Settings_ResetApp}" Command="{Binding Advanced.ResetCommand}" HorizontalAlignment="Left" AutomationProperties.Name="{x:Static res:Strings.Settings_ResetApp}" />
        </StackPanel>
      </Border>

      <!-- Restore original wallpaper -->
      <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Static res:Strings.Settings_Restore}" />
      <Border Style="{StaticResource CardStyle}" Padding="20,16">
        <StackPanel>
          <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Static res:Strings.Settings_RestoreOriginalHelp}" />
          <Button Margin="0,12,0,0" Content="{x:Static res:Strings.Settings_RestoreOriginal}" Command="{Binding Restore.RestoreCommand}" HorizontalAlignment="Left" AutomationProperties.Name="{x:Static res:Strings.Settings_RestoreOriginal}" />
          <ProgressBar IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding Restore.IsBusy, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{x:Static res:Strings.Settings_Restoring}" />
          <TextBlock Style="{StaticResource MutedStyle}" Margin="0,8,0,0" Text="{Binding Restore.ResultMessage}" Visibility="{Binding Restore.ResultMessage, Converter={StaticResource NullToCollapsed}}" />
          <TextBlock Style="{StaticResource ErrorTextStyle}" Margin="0,8,0,0" Text="{Binding Restore.ErrorMessage}" Visibility="{Binding Restore.HasError, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
