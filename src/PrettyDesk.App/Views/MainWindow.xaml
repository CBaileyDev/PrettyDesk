<ui:FluentWindow x:Class="PrettyDesk.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:vm="clr-namespace:PrettyDesk.Presentation.ViewModels;assembly=PrettyDesk.Presentation"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
                 Title="PrettyDesk"
                 Width="1000" Height="680" MinWidth="860" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 AutomationProperties.Name="PrettyDesk">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="PrettyDesk" ShowMaximize="True" />

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left rail: Home · Library · Defaults · Settings · About -->
      <ListBox x:Name="NavList"
               Grid.Column="0"
               Margin="8,8,8,8"
               Background="Transparent"
               BorderThickness="0"
               ItemsSource="{Binding NavItems}"
               SelectionChanged="OnNavSelectionChanged"
               AutomationProperties.Name="Main navigation">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:NavItem}">
            <StackPanel Orientation="Horizontal" Margin="4,8" AutomationProperties.Name="{Binding Label}">
              <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Text="{Binding Glyph}" VerticalAlignment="Center" Margin="0,0,12,0" />
              <TextBlock Text="{Binding Label}" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="0,0,0,0" Focusable="False" />
    </Grid>
  </Grid>
</ui:FluentWindow>
