<ui:FluentWindow x:Class="PrettyDesk.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:vm="clr-namespace:PrettyDesk.Presentation.ViewModels;assembly=PrettyDesk.Presentation"
                 xmlns:views="clr-namespace:PrettyDesk.App.Views"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
                 Title="PrettyDesk"
                 Width="1160" Height="780" MinWidth="860" MinHeight="560"
                 FontFamily="Segoe UI Variable, Segoe UI" Background="{DynamicResource DeskCanvasBrush}"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 AutomationProperties.Name="PrettyDesk">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="" Background="{DynamicResource DeskSidebarBrush}" Foreground="{DynamicResource DeskInkBrush}" ShowMaximize="True" AutomationProperties.Name="Window controls" />

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Sidebar: flush with the window edge, separated from the content by one hairline. -->
      <Border Background="{DynamicResource DeskSidebarBrush}" BorderBrush="{DynamicResource DeskStrokeBrush}" BorderThickness="0,1,1,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Viewbox x:Name="BrandLogo" Margin="20,18,20,22" Height="30" MaxWidth="170" Stretch="Uniform" HorizontalAlignment="Left" AutomationProperties.Name="PrettyDesk">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Canvas Width="32" Height="28" Margin="0,0,9,0" VerticalAlignment="Center">
                <Rectangle Canvas.Left="1" Canvas.Top="1" Width="28" Height="19" RadiusX="4" RadiusY="4" Stroke="{DynamicResource DeskInkBrush}" StrokeThickness="1.8" />
                <Path Data="M5,15 L11,8 L16,13 L20,9 L25,15 Z" Fill="{DynamicResource DeskAccentTextBrush}" />
                <Path Data="M15,21 L15,25 M9,25 L21,25" Stroke="{DynamicResource DeskInkBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              </Canvas>
              <TextBlock Text="PrettyDesk" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource DeskInkBrush}" VerticalAlignment="Center" />
            </StackPanel>
          </Viewbox>
          <ListBox x:Name="NavList"
                   Grid.Row="1"
                   Margin="12,0,12,16"
                   Foreground="{DynamicResource DeskMutedBrush}"
                   Background="Transparent"
                   BorderThickness="0"
                   ItemsSource="{Binding NavItems}"
                   SelectionChanged="OnNavSelectionChanged"
                   AutomationProperties.Name="Main navigation">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                  <Grid>
                    <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                      <ContentPresenter />
                    </Border>
                    <Border x:Name="Marker" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left" Margin="0" Background="{DynamicResource DeskAccentTextBrush}" Visibility="Collapsed" />
                    <Border x:Name="Ring" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource DeskAccentTextBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource DeskSoftBrush}" /></Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="{DynamicResource DeskAccentSoftBrush}" />
                      <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                      <Setter Property="Foreground" Value="{DynamicResource DeskAccentTextBrush}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible" /></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:NavItem}">
                <StackPanel Orientation="Horizontal" Margin="14,10" AutomationProperties.Name="{Binding Label}">
                  <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Text="{Binding Glyph}" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <views:MotionContentControl x:Name="PageHost" Grid.Column="1" Page="{Binding CurrentPage}" Focusable="False" />
    </Grid>
  </Grid>
</ui:FluentWindow>
