<ui:FluentWindow x:Class="PrettyDesk.App.Views.MessageDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="460" SizeToContent="Height" MinHeight="180"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="None"
                 Background="{DynamicResource DeskCanvasBrush}"
                 ExtendsContentIntoTitleBar="True">
  <Grid Margin="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar x:Name="Bar" Grid.Row="0" ShowMaximize="False" ShowMinimize="False" />
    <StackPanel Grid.Row="1" Margin="24,8,24,16">
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14" />
    </StackPanel>
    <StackPanel x:Name="ButtonRow" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,20" />
  </Grid>
</ui:FluentWindow>
