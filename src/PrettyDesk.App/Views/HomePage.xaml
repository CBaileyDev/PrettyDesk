<UserControl x:Class="PrettyDesk.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PrettyDesk.Presentation.ViewModels;assembly=PrettyDesk.Presentation"
             xmlns:res="clr-namespace:PrettyDesk.Presentation.Resources;assembly=PrettyDesk.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,32">
    <StackPanel>
      <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Static res:Strings.Home_Title}" />
      <!-- Environment conflicts (FR-APPLY-7): detected and explained, never silently fixed. -->
      <ItemsControl ItemsSource="{Binding Banners}" Margin="0,16,0,0" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:BannerViewModel}">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" BorderBrush="{Binding Severity, Converter={StaticResource SeverityToBrush}}" BorderThickness="4,1,1,1"
                    AutomationProperties.Name="{Binding Title}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock FontWeight="SemiBold" Style="{StaticResource BodyStyle}" Text="{Binding Title}" />
                  <TextBlock Style="{StaticResource MutedStyle}" Margin="0,4,0,0" Text="{Binding Message}" />
                </StackPanel>
                <Button Grid.Column="1" Content="{x:Static res:Strings.Banner_Dismiss}" VerticalAlignment="Top" Margin="12,0,0,0"
                        Command="{Binding DataContext.DismissBannerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        AutomationProperties.Name="{x:Static res:Strings.Banner_Dismiss}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Status card with the primary actions. Only the pause controls that apply to the current state are shown. -->
      <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="24,22">
        <StackPanel>
          <StackPanel AutomationProperties.Name="{Binding Headline}">
            <TextBlock FontSize="20" FontWeight="SemiBold" Style="{StaticResource BodyStyle}" Text="{Binding Headline}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Style="{StaticResource MutedStyle}" Margin="0,4,0,0" Text="{Binding Detail}" Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}" />
          </StackPanel>
          <WrapPanel Margin="0,20,0,0">
            <Button Style="{StaticResource PrimaryButtonStyle}" Content="{x:Static res:Strings.Home_NextWallpaper}" Command="{Binding NextCommand}" Margin="0,0,8,0" MinWidth="140"
                    AutomationProperties.Name="{x:Static res:Strings.Home_NextWallpaper}" />
            <Button Content="{x:Static res:Strings.Home_PauseOneHour}" Command="{Binding PauseForOneHourCommand}" Margin="0,0,8,0" Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{x:Static res:Strings.Home_PauseOneHour}" />
            <Button Content="{x:Static res:Strings.Home_PauseUntilResumed}" Command="{Binding PauseUntilResumedCommand}" Margin="0,0,8,0" Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{x:Static res:Strings.Home_PauseUntilResumed}" />
            <Button Content="{x:Static res:Strings.Home_Resume}" Command="{Binding ResumeCommand}" Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{x:Static res:Strings.Home_Resume}" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <!-- To-scale preview of every display with its current wallpaper. -->
      <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="24,20">
        <StackPanel>
          <TextBlock Style="{StaticResource BodyStyle}" FontWeight="SemiBold" Text="{x:Static res:Strings.Home_PreviewLabel}" Margin="0,0,0,12" />
          <Viewbox Stretch="Uniform" MaxHeight="300" Visibility="{Binding HasMonitors, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Monitors}" Width="{x:Static vm:HomeViewModel.CanvasWidth}" Height="{Binding CanvasHeight}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <Canvas />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter" d:DataType="{x:Type vm:MonitorPreviewViewModel}">
                  <Setter Property="Canvas.Left" Value="{Binding X}" />
                  <Setter Property="Canvas.Top" Value="{Binding Y}" />
                </Style>
              </ItemsControl.ItemContainerStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MonitorPreviewViewModel}">
                  <Grid Width="{Binding Width}" Height="{Binding Height}" AutomationProperties.Name="{Binding Label}">
                    <Border Style="{StaticResource PlaceholderTileStyle}" BorderBrush="{DynamicResource DeskStrokeBrush}" BorderThickness="3" CornerRadius="6" />
                    <Border CornerRadius="6" BorderThickness="3" BorderBrush="{DynamicResource DeskStrokeBrush}" Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}">
                      <Border.Background>
                        <ImageBrush ImageSource="{Binding ThumbnailPath, Converter={StaticResource PathToImage}, ConverterParameter=960}" Stretch="UniformToFill" />
                      </Border.Background>
                    </Border>

                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Viewbox>

          <ItemsControl ItemsSource="{Binding Monitors}" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:MonitorPreviewViewModel}">
              <TextBlock Text="{Binding Label}" Style="{StaticResource MutedStyle}" FontSize="13" Margin="0,2" />
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Visibility="{Binding HasMonitors, Converter={StaticResource InverseBoolToVisibility}}" Margin="0,24" HorizontalAlignment="Center">
            <TextBlock Style="{StaticResource BodyStyle}" FontWeight="SemiBold" HorizontalAlignment="Center" Text="{x:Static res:Strings.Home_NoMonitors}" />
            <TextBlock Style="{StaticResource MutedStyle}" HorizontalAlignment="Center" TextAlignment="Center" Text="{x:Static res:Strings.Home_NoMonitorsDetail}" />
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
