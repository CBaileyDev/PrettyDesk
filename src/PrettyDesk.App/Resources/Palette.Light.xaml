<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Surfaces: canvas behind, cards on top. Solid colours only, so nothing here costs a blur or a composition pass. -->
  <SolidColorBrush x:Key="DeskCanvasBrush" Color="#F3F4F7" />
  <SolidColorBrush x:Key="DeskSidebarBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="DeskSurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="DeskSoftBrush" Color="#EEF0F5" />
  <SolidColorBrush x:Key="DeskVeilBrush" Color="#12000000" />
  <SolidColorBrush x:Key="DeskStrokeBrush" Color="#E1E4EB" />
  <!-- Text -->
  <SolidColorBrush x:Key="DeskInkBrush" Color="#0F1729" />
  <SolidColorBrush x:Key="DeskMutedBrush" Color="#556072" />
  <!-- Accent: fill for buttons and switches, text for links and selected labels, tint for selected rows -->
  <SolidColorBrush x:Key="DeskAccentBrush" Color="#5B5BD6" />
  <SolidColorBrush x:Key="DeskAccentTextBrush" Color="#4747C2" />
  <SolidColorBrush x:Key="DeskAccentSoftBrush" Color="#EBEBFC" />
  <SolidColorBrush x:Key="DeskOnAccentBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#4C4CC4" />
  <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#3E3EAE" />
</ResourceDictionary>
