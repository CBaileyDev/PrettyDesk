<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:PrettyDesk.App.Converters"
                    xmlns:views="clr-namespace:PrettyDesk.App.Views"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <!-- Colours live in Palette.Light/Dark/HighContrast.xaml; AppAppearance swaps the one in use. Everything here refers to them dynamically. -->

  <Style TargetType="Window">
    <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
    <Setter Property="Background" Value="{DynamicResource DeskCanvasBrush}" />
  </Style>
  <Style TargetType="UserControl">
    <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
  <conv:InverseBoolConverter x:Key="InverseBool" />
  <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
  <conv:EnumEqualsToVisibilityConverter x:Key="EnumEqualsToVisibility" />
  <conv:EnumEqualsConverter x:Key="EnumEquals" />
  <conv:PathToImageConverter x:Key="PathToImage" />
  <conv:SeverityToBrushConverter x:Key="SeverityToBrush" />
  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

  <!-- Buttons: a flat bordered control. A translucent veil darkens it (lightens it in dark mode) on hover, so one template serves every colour. -->
  <Style TargetType="Button">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource DeskInkBrush}" />
    <Setter Property="Background" Value="{DynamicResource DeskSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DeskStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <Border x:Name="Veil" CornerRadius="6" Background="{DynamicResource DeskVeilBrush}" Opacity="0" IsHitTestVisible="False" />
            <Border x:Name="Ring" CornerRadius="8" Margin="-2" BorderThickness="2" BorderBrush="{DynamicResource DeskAccentTextBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Veil" Property="Opacity" Value="1" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.85" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45" /><Setter TargetName="Veil" Property="Opacity" Value="0" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{DynamicResource DeskOnAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource DeskAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DeskAccentBrush}" />
  </Style>

  <!-- A button with no chrome of its own, for clickable cards: it only adds a keyboard focus ring. -->
  <Style x:Key="FlatButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="{TemplateBinding Background}">
            <ContentPresenter />
            <Border x:Name="Ring" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource DeskAccentTextBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ui:ToggleSwitch" BasedOn="{StaticResource DefaultUiToggleSwitchStyle}">
    <Setter Property="Background" Value="{DynamicResource DeskAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DeskInkBrush}" />
  </Style>
  <Style TargetType="ui:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14,6" />
  </Style>

  <!-- Segmented choice: put RadioButtons with this style inside a SegmentedBarStyle border. -->
  <Style x:Key="SegmentedBarStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource DeskSoftBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style x:Key="SegmentedOptionStyle" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource DeskMutedBrush}" />
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Grid>
        <Border x:Name="Segment" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent">
          <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border>
        <Border x:Name="Ring" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource DeskAccentTextBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Segment" Property="Background" Value="{DynamicResource DeskVeilBrush}" /></Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Setter TargetName="Segment" Property="Background" Value="{DynamicResource DeskAccentBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource DeskOnAccentBrush}" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Segment" Property="Opacity" Value="0.45" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- A whole card that is one radio choice: accent border and tint when selected. -->
  <Style x:Key="ChoiceCardStyle" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource DeskInkBrush}" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Grid>
        <Border x:Name="Card" CornerRadius="10" BorderThickness="1" Padding="{TemplateBinding Padding}"
                Background="{DynamicResource DeskSurfaceBrush}" BorderBrush="{DynamicResource DeskStrokeBrush}">
          <ContentPresenter />
        </Border>
        <Border x:Name="Ring" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource DeskAccentTextBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource DeskSoftBrush}" /></Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Setter TargetName="Card" Property="Background" Value="{DynamicResource DeskAccentSoftBrush}" />
          <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource DeskAccentTextBrush}" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Text -->
  <Style x:Key="PageTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource DeskInkBrush}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource DeskInkBrush}" />
    <Setter Property="Margin" Value="0,28,0,10" />
  </Style>

  <Style x:Key="BodyStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DeskInkBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="MutedStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStyle}">
    <Setter Property="Foreground" Value="{DynamicResource DeskMutedBrush}" />
  </Style>

  <Style x:Key="ErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStyle}">
    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
  </Style>

  <!-- Surfaces -->
  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource DeskSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DeskStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="20,16" />
  </Style>

  <Style x:Key="ChipStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource DeskSoftBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style x:Key="DividerStyle" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource DeskStrokeBrush}" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>

  <!-- One setting: title and help on the left, its control on the right. -->
  <Style x:Key="SettingRowStyle" TargetType="HeaderedContentControl">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Padding" Value="0,12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="HeaderedContentControl">
          <Grid Margin="{TemplateBinding Padding}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
              <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource BodyStyle}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding (views:SettingRow.Description), RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource MutedStyle}" FontSize="13" Margin="0,2,0,0"
                         Visibility="{Binding (views:SettingRow.Description), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Designed placeholder tile for art that is not on disk yet (SPEC §7: empty states are designed, not blank). -->
  <Style x:Key="PlaceholderTileStyle" TargetType="Border">
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FF2A2F55" Offset="0" />
          <GradientStop Color="#FF3FB6A8" Offset="1" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="CornerRadius" Value="6" />
  </Style>
</ResourceDictionary>
