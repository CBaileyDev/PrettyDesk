<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>PrettyDesk</AssemblyName>
    <RootNamespace>PrettyDesk.App</RootNamespace>
    <StartupObject>PrettyDesk.App.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PrettyDesk.ico</ApplicationIcon>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Description>Switches your Windows 11 wallpaper to game-inspired art while you play.</Description>
    <!-- OWNER-DECISION (SPEC §13.2): the content host. Pass -p:ContentBaseUrl=https://.../v1/ at build time; empty = offline-only build. -->
    <ContentBaseUrl Condition="'$(ContentBaseUrl)' == ''"></ContentBaseUrl>
    <!-- Version comes from the git tag (v1.2.3, v1.3.0-beta.1) via MinVer; untagged builds are 1.0.0-dev.* so the 1.0.0 catalog still loads. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>1.0</MinVerMinimumMajorMinor>
    <MinVerDefaultPreReleaseIdentifiers>dev</MinVerDefaultPreReleaseIdentifiers>
    <DefineConstants Condition="'$(AcceptanceTesting)' == 'true'">$(DefineConstants);PRETTYDESK_ACCEPTANCE</DefineConstants>
    <!-- Crossgen2 runs on the x64 build host when publishing ARM64. Its host runtime is part of the restore graph;
         declare it before locked-mode validation so restore and publish agree on that graph. -->
    <RuntimeIdentifiers Condition="'$(PublishReadyToRun)' == 'true' And '$(RuntimeIdentifier)' == 'win-arm64'">win-arm64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <!-- A tray utility should not retain a large ephemeral heap on high-memory PCs. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="33554432" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PrettyDesk.Core\PrettyDesk.Core.csproj" />
    <ProjectReference Include="..\PrettyDesk.Presentation\PrettyDesk.Presentation.csproj" />
    <ProjectReference Include="..\PrettyDesk.Windows\PrettyDesk.Windows.csproj" />
    <InternalsVisibleTo Include="PrettyDesk.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The WPF SDK drops these implicit usings because of the System.IO.Path / Shapes.Path clash; we never import Shapes. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <!-- We provide our own Main (single-instance check, Velopack hooks), so App.xaml is a plain page. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Assets\*.ico" />
    <Resource Include="Assets\Glass-*.jpg" />
    <EmbeddedResource Include="THIRD-PARTY-NOTICES.txt" LogicalName="THIRD-PARTY-NOTICES.txt" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ContentBaseUrl</_Parameter1>
      <_Parameter2>$(ContentBaseUrl)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(AcceptanceTesting)' == 'true'">
      <_Parameter1>AcceptanceDataRoot</_Parameter1>
      <_Parameter2>$(AcceptanceDataRoot)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <!-- The bundled catalog snapshot (FR-CON-1) is the source catalog; the signed copy from the content host replaces it once newer. -->
    <Content Include="..\..\content\catalog.src.json" Link="content\catalog.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\..\content\starter')">
    <Content Include="..\..\content\starter\**\*" Link="content\starter\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
